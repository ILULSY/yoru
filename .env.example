# ─────────────────────────────────────────────────────────────
# YORU — variables d'environnement
# Copiez ce fichier en `.env.local` et complétez ce dont vous avez besoin.
# Aucune de ces valeurs n'est obligatoire pour lancer le site en local :
# les fonctionnalités concernées affichent un état « non configuré » honnête.
# ─────────────────────────────────────────────────────────────

# URL publique du site (canonical, sitemap, Open Graph, RSS)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Newsletter (fournisseur : Brevo) ─────────────────────────
# Clé API Brevo (côté serveur uniquement, jamais exposée au navigateur)
BREVO_API_KEY=
# Identifiant numérique de la liste de contacts Brevo
BREVO_LIST_ID=
# Double opt-in (recommandé, RGPD) : ID du modèle d'e-mail DOI dans Brevo
BREVO_DOI_TEMPLATE_ID=
# URL de redirection après confirmation (ex. https://votre-domaine.fr/newsletter/merci)
BREVO_DOI_REDIRECT_URL=

# ── Formulaire de contact (fournisseur : Resend) ─────────────
RESEND_API_KEY=
# Adresse qui reçoit les messages
CONTACT_TO_EMAIL=
# Expéditeur vérifié dans Resend (ex. "YORU <contact@votre-domaine.fr>")
CONTACT_FROM_EMAIL=

# ── Boutique : paiement (fournisseur : Stripe Checkout) ──────
# Clé secrète (sk_test_… pour tester, sk_live_… en production). Côté serveur uniquement.
# Les produits de démonstration ne peuvent être payés qu'avec une clé sk_test_.
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_…), endpoint : /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ── Espace édition (/admin) ─────────────────────────────────
# Mot de passe de connexion (12 caractères minimum). Côté serveur uniquement.
ADMIN_PASSWORD=
# Secret de signature des sessions : 32 caractères aléatoires minimum, par ex.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Le changer (ou changer le mot de passe) déconnecte toutes les sessions.
ADMIN_SESSION_SECRET=

# ── Boutique : stockage du catalogue ─────────────────────────
# "file" (défaut : data/shop/catalog.json, serveur avec disque inscriptible)
# ou "supabase" (hébergement serverless type Vercel ; schéma : supabase/schema.sql)
PRODUCTS_SOURCE=file
# Requis si PRODUCTS_SOURCE=supabase (avec SUPABASE_URL ci-dessous).
# Clé « service_role » / « secret » : contourne RLS, ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket public Supabase Storage pour les photos produit
SUPABASE_PRODUCTS_BUCKET=products

# ── Contenus ─────────────────────────────────────────────────
# "local" (par défaut : fichiers typés dans /data) ou "supabase"
CONTENT_SOURCE=local
# Requis si CONTENT_SOURCE=supabase (lecture publique protégée par RLS)
SUPABASE_URL=
SUPABASE_ANON_KEY=
